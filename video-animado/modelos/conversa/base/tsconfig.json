{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "preserveSymlinks": true
  },
  "include": [
    "componentes",
    "personagens",
    "_preview",
    "_ferramentas/episodio-base/src",
    "videos/*/src"
  ]
}
